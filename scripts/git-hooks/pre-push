#!/bin/sh
# pre-push —— 推 refs/heads/main 前核「落地锁」：锁里记的 SHA 必须等于要推的 SHA。
#
# 目的：把 docs/agents/parallel-sessions.md「推送：推经验证的确切 SHA」从约定变成本机强制。
# 所有 worktree 共用同一个 .git（git rev-parse --git-common-dir），钩子装一次对每棵树的 push 都生效。
# 它挡的是「没走落地流程就推 main」，挡不了有意绕过（--no-verify）；那一层归分支保护，本仓私有免费档开不了。
#
# 安装（切换到「作者自落 main」那天，由推送方执行一次）：
#   Copy-Item scripts/git-hooks/pre-push (git rev-parse --git-common-dir)/hooks/pre-push
# 落地流程写锁（验完那个 SHA 之后、push 之前）：
#   Set-Content -NoNewline -Encoding ascii (git rev-parse --git-common-dir)/landing.lock "<完整 SHA>`n<通道号>"
# push 完删锁：
#   Remove-Item (git rev-parse --git-common-dir)/landing.lock
#
# stdin 每行：<local ref> <local sha> <remote ref> <remote sha>
remote_name="$1"
common_dir=$(git rev-parse --git-common-dir 2>/dev/null || echo .git)
lock="$common_dir/landing.lock"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      if [ ! -f "$lock" ]; then
        echo "pre-push: 推 $remote_name/main 需要落地锁 $lock（第一行写要推的完整 SHA，第二行写通道号）；流程见 docs/agents/parallel-sessions.md「落 main 的下一形态」" >&2
        status=1
        continue
      fi
      want=$(head -n 1 "$lock" | tr -d '\r\n ')
      if [ "$want" != "$local_sha" ]; then
        echo "pre-push: 落地锁记的是 $want，要推的是 $local_sha —— 验哪个 SHA 推哪个 SHA，先重验再改锁" >&2
        status=1
        continue
      fi
      ;;
  esac
done
exit $status
