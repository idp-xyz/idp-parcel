{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "international-parcel-rating-golden-cases-v1.0.schema.json",
  "title": "International Parcel Rating Golden Cases V1.0.1",
  "type": "object",
  "required": [
    "suite_id",
    "version",
    "status",
    "normative_baselines",
    "source_artifacts",
    "canonical_enums",
    "fixtures",
    "coverage",
    "cases"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "suite_id": {
      "const": "INTERNATIONAL_PARCEL_RATING_GOLDEN_CASES"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.0(\\.1)?$"
    },
    "status": {
      "enum": [
        "DRAFT",
        "REVIEWED",
        "FINAL_REVIEWED"
      ]
    },
    "generated_at": {
      "type": "string"
    },
    "normative_baselines": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "document",
          "version",
          "file"
        ]
      }
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "sha256",
          "role"
        ]
      }
    },
    "canonical_enums": {
      "type": "object",
      "required": [
        "calculation_purpose",
        "price_role",
        "charge_scope",
        "charge_effect",
        "rate_table_family",
        "aggregation_mode"
      ]
    },
    "fixtures": {
      "type": "object"
    },
    "source_discrepancies": {
      "type": "array"
    },
    "coverage": {
      "type": "object",
      "required": [
        "planned_case_count",
        "categories"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 136,
      "maxItems": 136,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "category",
          "title",
          "operation",
          "source_kind",
          "source_refs",
          "inputs",
          "expected",
          "tags"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^(GEO|WGT|BND|AGG|RT|CHG|FDC|BS|FX|ERR|RPL)-\\d{3}$"
          },
          "category": {
            "enum": [
              "UNIT_GEOMETRY",
              "WEIGHT",
              "BOUNDARY",
              "AGGREGATION",
              "RATE_TABLE",
              "CHARGE",
              "FUEL_DISCOUNT_CAP",
              "BUY_SELL",
              "CURRENCY",
              "ERROR",
              "REPLAY"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": [
              "GEOMETRY",
              "WEIGHT",
              "FEATURE",
              "AGGREGATION",
              "RATE_LOOKUP",
              "CHARGE_FIXED",
              "SHIPPING_CORRECTION",
              "FUEL",
              "SURCHARGE_DISCOUNT",
              "MINIMUM_ADJUSTMENT",
              "MAXIMUM_CAP",
              "SELL",
              "FX",
              "STATIC_ERROR",
              "REPLAY"
            ]
          },
          "source_kind": {
            "enum": [
              "SOURCE_RATE_CARD",
              "NORMATIVE_SYNTHETIC",
              "UPSTREAM_CONSISTENCY"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputs": {
            "type": "object"
          },
          "expected": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "COMPLETED",
                  "FAILED"
                ]
              },
              "result": {
                "type": "object"
              },
              "error_code": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "COMPLETED"
                    }
                  }
                },
                "then": {
                  "required": [
                    "result"
                  ],
                  "not": {
                    "required": [
                      "error_code"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "FAILED"
                    }
                  }
                },
                "then": {
                  "required": [
                    "error_code"
                  ],
                  "not": {
                    "required": [
                      "result"
                    ]
                  }
                }
              }
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}